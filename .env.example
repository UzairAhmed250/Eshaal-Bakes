# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
# Server-only secret! Never expose to client or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bot Protection (Cloudflare Turnstile - optional; falls back to honeypot + strict rate limiting when omitted)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional Email Notifications via Resend (disabled when empty)
ENABLE_EMAIL_NOTIFICATIONS="false"
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="orders@eshalbakes.pk"

# Demo / Local Admin Credentials (used when running in local-demo mode without live Supabase)
DEMO_ADMIN_EMAIL="admin@eshalbakes.pk"
DEMO_ADMIN_PASSWORD="KarachiBaker#2026!"
DEMO_SESSION_SECRET="eshaal-bakes-local-hmac-secret-change-in-production-32bytes"
